# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# python
__pycache__/
*.pyc
venv/

# production
/build

# misc
.DS_Store
*.pem
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets are never committed
# .env.local files contain secrets everywhere
**/.env.local
**/.env*.local

# Root .env has secrets
/.env

# Backend .env has secrets (use .env.production for public config)
/backend/.env

# Leadgen .env has secrets
/leadgen/.env

# frontend/.env is safe to commit (only NEXT_PUBLIC_ vars)
# backend/.env.production is safe to commit (only public config)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
sorapixel-vertex-key.json
gcp-vertex-key.json
*.json.bak

# GCP deployment env files (contain secrets)
backend/env.yaml
frontend/env.yaml
leadgen/env.yaml
leadgen-saas/env.yaml

# Claude
.claude/
